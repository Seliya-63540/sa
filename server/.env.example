# ==========================================
# SAFAR CYCLE - Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5000

# Client Allowed Origins (comma-separated if multiple)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (Relative to server directory or absolute path)
DATABASE_PATH=./database/safar_cycle.sqlite

# Session Management
SESSION_SECRET=safar_cycle_super_secret_session_key_2026_change_in_production
SESSION_MAX_AGE_MS=604800000

# Business Information Defaults
BUSINESS_NAME=SAFAR CYCLE
BUSINESS_NAME_GUJARATI=સફર સાઇકલ
BUSINESS_TIMEZONE=Asia/Kolkata
BUSINESS_CURRENCY=INR

# File Storage Directories
UPLOAD_DIRECTORY=./storage/uploads
BACKUP_DIRECTORY=./storage/backups

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Initial Admin Configuration (for initial seed / bootstrap)
INITIAL_ADMIN_NAME=SAFAR Workshop Owner
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PHONE=9876543210
INITIAL_ADMIN_PASSWORD=admin123
