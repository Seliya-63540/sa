{
  "name": "safar-cycle-backend",
  "version": "1.0.0",
  "description": "Backend API for SAFAR CYCLE - Cycle Shop, Sales, Repair & Workshop Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:status": "node src/database/migrate.js --status",
    "seed:admin": "node src/database/seeds/createAdmin.js",
    "test": "node --test tests/integration/*.test.js"
  },
  "keywords": [
    "safar-cycle",
    "cycle-shop",
    "workshop",
    "express",
    "sqlite3"
  ],
  "author": "SAFAR CYCLE Architecture Team",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.2",
    "connect-sqlite3": "^0.9.18",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "sqlite3": "^5.1.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  }
}
